{"_id":"3s0Zj4kDffP0guLK","name":"Biologist's Hazard Suit","type":"armor","img":"modules/fvtt_mosh_1e_psg/icons/armor/hazard_suit.png","system":{"description":"<p>Reinforced full-body containment suit rated for class-IV biological hazards. Standard issue for field researchers operating in unknown biospheres.<br><br><strong>Includes</strong> air filtration, contamination seals, integrated medscanner feed, headlamp, and short-range comms.</p>","armorPoints":12,"damageReduction":0,"oxygenCurrent":0,"oxygenMax":0,"weight":0,"cost":20000,"speed":"[-]","features":"","equipped":false},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"R06Nm84JCJCYTPJI","name":"Void Monk's Habit","type":"armor","img":"modules/fvtt_mosh_1e_psg/icons/armor/manufacturer_supplied_attire.png","system":{"description":"<p>Reinforced monastic robes woven with void-hardened composite fiber. Functional and austere \u2014 those who wear them have renounced everything except purpose.<br><br><strong>Includes</strong> integrated oxygen recycler and short-range comms sewn into the lining.</p>","armorPoints":12,"damageReduction":1,"oxygenCurrent":0,"oxygenMax":0,"weight":0,"cost":0,"speed":"Normal","features":"","equipped":false},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"IKDSpoZNlXG2qX8Q","name":"Xenobiologist's Field Suit","type":"armor","img":"modules/fvtt_mosh_1e_psg/icons/armor/hazard_suit.png","system":{"description":"<p>Lightweight composite armor designed for close observation of dangerous fauna. Flexible enough for fieldwork, tough enough to survive a bite.<br><br><strong>Includes</strong> body cam, bioscanner uplink, filter mask, and reinforced gloves.</p>","armorPoints":10,"damageReduction":0,"oxygenCurrent":0,"oxygenMax":0,"weight":0,"cost":12000,"speed":"Normal","features":"","equipped":false},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"28cF8SewxMvLTi0G","name":"Enforcement Rig","type":"armor","img":"modules/fvtt_mosh_1e_psg/icons/armor/standard_battle_dress.png","system":{"description":"<p>Heavy tactical armor favored by licensed bounty hunters and enforcement contractors. Built to take punishment while keeping the target alive.<br><br><strong>Includes</strong> helmet with HUD, short-range comms, restraint loops, reinforced joint plating, and mag-lock holster.</p>","armorPoints":15,"damageReduction":3,"oxygenCurrent":0,"oxygenMax":0,"weight":0,"cost":35000,"speed":"[-]","features":"","equipped":false},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
